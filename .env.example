# ==============================================================================
# QRDine SaaS - Split Architecture Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (Node / Express Backend API) - Environment Variables
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=10000
APP_URL="https://your-api.onrender.com"
FRONTEND_URL="https://your-app.vercel.app"

# Cryptographic Session Secret for HMAC token signing (Generate random 32+ char string)
SESSION_SECRET="generate_a_random_secure_32_char_secret_here"

# Supabase Database & Auth (Backend)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Razorpay Payments (Backend Live/Test API Keys)
RAZORPAY_KEY_ID="rzp_live_or_test_YourKeyId"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Resend Transactional Emails (Digital Tax Invoices & Order Confirmations)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="orders@yourdomain.com"

# ------------------------------------------------------------------------------
# 2. VERCEL (React / Vite Frontend SPA) - Environment Variables
# ------------------------------------------------------------------------------
VITE_API_URL="https://your-api.onrender.com"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_RAZORPAY_KEY_ID="rzp_live_or_test_YourKeyId"

# ------------------------------------------------------------------------------
# 3. Supabase Auth Configuration (Dashboard Settings)
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Authentication -> URL Configuration:
# Site URL: https://your-app.vercel.app
# Redirect URLs:
# - https://your-app.vercel.app/**
# - http://localhost:5173/**

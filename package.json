{
  "name": "qrdine-saas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,client\" -c \"cyan,green\" \"tsx server.ts\" \"vite\"",
    "dev:server": "tsx server.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.js",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.1",
    "@types/cors": "^2.8.19",
    "@types/qrcode": "^1.5.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
